# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_par_mux_global_optspecs
    string join \n check-update self-update force-self-update socket= state-dir= machine= stop restart foreground par-mux-in-app-wrapper no-attach c/cmd= list-servers pane-endpoints expose-control-socket gen-config force install-skill skills-dir= install-agent-hooks uninstall-agent-hooks agent-hooks-status integration-status install-agent-extensions uninstall-agent-extensions heal-agent-hooks print-schema print-completions= h/help V/version
end

function __fish_par_mux_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_par_mux_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_par_mux_using_subcommand
    set -l cmd (__fish_par_mux_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

