(( $+functions[_par-mux_commands] )) ||
_par-mux_commands() {
    local commands; commands=(
'start:Start the daemon (the default action)\: detached, auto-attaching this terminal unless --no-attach. Same as bare \`par-mux \[NAME\]\`' \
'stop:Stop the daemon serving the resolved socket cleanly. Same as \`--stop\`' \
'restart:Stop, then start a fresh daemon that restores the saved tree. Same as \`--restart\`' \
'status:One-shot orientation\: the daemon'\''s build stamp, its workspaces and sessions, the displayed session, and the pane count — the orient step in one invocation (R2)' \
'ls:List the resolved daemon'\''s sessions (\`list-sessions\`, tmux'\''s \`ls\`)' \
'attach:Attach a client to a running daemon; never starts one. The feature-gated interactive client' \
'config:Write the config file with the current effective settings. Same as \`--gen-config\` (add \`--force\` to overwrite)' \
'observe:Stream one pane'\''s raw output to stdout, read-only (\`observe-pane\`)\: the screen seed, then live PTY bytes until the pane closes. Any number of observers may watch the same pane' \
'control:Drive one pane (\`control-pane\`)\: stream its output to stdout like \`observe\`, forward stdin bytes to it until EOF (no raw mode — for pipes and scripts; interactive use is \`attach -t %N\`), and report this terminal'\''s size (polled) or \`--size\` as a viewer of the pane'\''s window' \
'completion:Print the shell-completion script for SHELL, herdr'\''s spelling of \`--print-completions\`. Never contacts a daemon' \
'machine:Manage saved machines (\`\[machines.<label>\]\` in the config)\: SSH thin-client profiles for \`--machine\`. Never contacts a daemon' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'par-mux commands' commands "$@"
}
