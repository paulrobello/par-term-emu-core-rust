#compdef par-mux

autoload -U is-at-least

_par-mux() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--socket=[Bind an explicit socket path instead of the named default]:PATH:_files' \
'--state-dir=[Override the platform state directory (D3.4) that persisted session trees are written under, instead of the OS-standard state/data dir]:DIR:_files' \
'--machine=[Relay this invocation to a saved machine over SSH (the machine'\''s profile in \`\[machines.<label>\]\` names the ssh target; credentials stay with ssh itself). One-shot commands (\`--cmd\`, \`status\`, \`ls\`, \`observe\`, \`control\`, \`--stop\`) run non-interactively; \`attach\` forces passthrough under a pty — the thin client]:LABEL:_default' \
'(--state-dir)-c+[Client mode\: send one control command to the daemon on this socket, print its reply body to stdout (one line per reply line), and exit. A \`%error\` reply prints to stderr and exits non-zero. Never starts a daemon. A flag, like --stop, so the positional NAME stays unambiguous]:COMMAND:_default' \
'(--state-dir)--cmd=[Client mode\: send one control command to the daemon on this socket, print its reply body to stdout (one line per reply line), and exit. A \`%error\` reply prints to stderr and exits non-zero. Never starts a daemon. A flag, like --stop, so the positional NAME stays unambiguous]:COMMAND:_default' \
'--skills-dir=[With --install-skill\: write under this skills root instead of the Claude Code default (tests, other agent harnesses)]:DIR:_files' \
'--print-completions=[Print the shell-completion script for SHELL (bash, zsh, fish, powershell, elvish) generated from this CLI, and exit. Never contacts a daemon]:SHELL:(bash elvish fish powershell zsh)' \
'--stop[Stop the daemon serving this socket cleanly (final state save, \`%exit\` to clients) and wait for it to exit. Flags rather than subcommands\: the positional NAME would otherwise be ambiguous with a session named \`stop\`]' \
'--restart[Stop the running daemon (as --stop), then start a fresh one on the same socket — it restores the tree the stop just saved. Use after rebuilding par-mux\: clients attach to whatever daemon owns the socket, so an old daemon keeps serving old code until restarted]' \
'(--no-attach --stop -c --cmd --list-servers --gen-config --install-skill --install-agent-hooks --uninstall-agent-hooks --agent-hooks-status --integration-status --install-agent-extensions --uninstall-agent-extensions --heal-agent-hooks --print-schema --print-completions)--foreground[Serve the daemon in the foreground of this process instead of the default daemonize-to-background\: the debugging and supervision escape, and the shape programmatic spawners use (they own and kill the child they spawned). Not a daemon_mode member on purpose\: it composes with --restart (stop, then serve here)]' \
'(--foreground --stop -c --cmd --list-servers --gen-config --install-skill --install-agent-hooks --uninstall-agent-hooks --agent-hooks-status --integration-status --install-agent-extensions --uninstall-agent-extensions --heal-agent-hooks --print-schema --print-completions)--no-attach[Daemon-only\: daemonize to background as usual but skip the auto-attach of the invoking terminal (and the isatty fallback that skips attaching for scripted starts)]' \
'--list-servers[Client mode\: list every live par-mux server this user can reach — registry entries plus the named-default sockets on disk — one line per server (\`<name-or-path>  sessions=N  stamp\`), pruning registry entries whose probe failed. Never starts a daemon. Honors \`--state-dir\`, so tests can point the registry at a fixture; with \`--socket\`/NAME, the named/default resolution is skipped for the target socket (discovery is user-wide, not per-socket)]' \
'--pane-endpoints[Give each pane its own hook-only socket endpoint\: \`PAR_MUX_SOCKET\` in a pane then names a socket that accepts ONLY hook reports for that pane, so its child processes cannot drive other panes or stop the server. Default off — the in-pane full-socket fallback is a core feature; see docs/MUX.md for the trade and the default-flip gate]' \
'--expose-control-socket[With --pane-endpoints\: also export \`PAR_MUX_CONTROL_SOCKET\` (the full control socket) in every pane, so agent-driven pane control keeps working. A session env of \`PAR_MUX_CONTROL=1\` grants the same per session without this flag]' \
'--gen-config[Write the config file with the CURRENT EFFECTIVE settings (file if present > env > built-in defaults; startup CLI flags are not introspectable after parse, so a flagged value that also appears here wins only where this code path sees the flag — the socket and the daemon bools). Never overwrites without --force. With no config file yet, this is how a user starts one]' \
'--force[With --gen-config\: overwrite an existing config file]' \
'--install-skill[Install the bundled par-mux agent skill into the Claude Code skills directory and exit. Never starts or contacts a daemon, so it runs anywhere, including inside a pane; par-term invokes it after installing par-mux so the skill matches the shipped binary]' \
'--install-agent-hooks[Install the agent-state session hooks for claude, codex, grok, muse, droid, copilot, and cursor (script assets plus the config entries that run them) and exit. Never starts or contacts a daemon; par-term invokes it instead of embedding its own copies of the integrations]' \
'--uninstall-agent-hooks[Remove the agent-state session hooks par-mux installed\: the config entries first, then the script assets. Never contacts a daemon]' \
'--agent-hooks-status[Print one line per agent — \`<agent> installed\` or \`<agent> absent\` — and exit\: the read-only state behind the par-term Settings rows]' \
'--integration-status[Print one line per integration — the agent hooks, the pi/omp extensions, and the par-mux skill — naming each one'\''s version and whether the installed asset matches the bundled copy (\`v2\`, \`v1 → v2 outdated\`, \`asset missing\`, or \`absent\`), and exit]' \
'--install-agent-extensions[Install the pi and omp agent-state extensions (a file drop into each agent extension directory) and exit. Never contacts a daemon]' \
'--uninstall-agent-extensions[Remove the pi and omp agent-state extensions par-mux installed]' \
'--heal-agent-hooks[Rewrite a registered hook script asset that went missing (the hooks directory has been deleted externally while the agent config entries survived) without touching any agent config — the startup self-heal par-term runs. Never contacts a daemon]' \
'--print-schema[Print the versioned JSON command schema (every control command, its flags, and its feature tokens) bundled with this binary, and exit. Never contacts a daemon; \`list-commands -J\` serves the same document from a running one]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::name -- Named default socket path (par-mux\:\:default_socket_path). Ignored if --socket is set; if absent, `$PAR_MUX_SOCKET` decides before the `default` name does:_default' \
